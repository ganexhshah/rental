ENV=development
PORT=8080
API_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6380
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443

POSTGRES_USER=rental_admin
POSTGRES_PASSWORD=rental_secret_2026
POSTGRES_DB=rental_saas_db
DATABASE_URL=postgres://rental_admin:rental_secret_2026@localhost:5433/rental_saas_db?sslmode=disable
